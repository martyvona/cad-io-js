{
  "name": "tess-workers",
  "version": "0.3.0",
  "description": "Runs a cad-io-js tessellation backend in a pool of workers (worker_threads in Node, Web Workers in browsers), with a timeout and instance recycling",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "node": "./src/node.ts",
      "default": "./src/browser.ts"
    },
    "./web-worker": "./src/web-worker.ts",
    "./browser": "./src/browser.ts"
  },
  "dependencies": {
    "cad-brep": "0.3.0",
    "cad-oracle": "0.3.0",
    "cad-scene": "0.3.0",
    "tess-cadio": "0.3.0"
  },
  "devDependencies": {
    "cad-geom": "0.3.0",
    "cad-heal": "0.3.0",
    "step-import": "0.3.0",
    "tess-occt": "0.3.0"
  }
}
