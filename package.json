{
  "name": "cad-io-js",
  "version": "0.1.0",
  "description": "Reading CAD files into memory, and converting them, in TypeScript for Node.js and browsers: STEP to a scene model, tessellated by WebAssembly backends (OCCT, truck), exported to three.js, glTF and 3MF, with a browser viewer",
  "keywords": [
    "cad",
    "step",
    "iso-10303",
    "ap242",
    "gltf",
    "3mf",
    "three.js",
    "occt",
    "tessellation",
    "viewer"
  ],
  "homepage": "https://github.com/martyvona/cad-io-js#readme",
  "bugs": {
    "url": "https://github.com/martyvona/cad-io-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martyvona/cad-io-js.git"
  },
  "license": "Apache-2.0",
  "contributors": [
    "Claude (Anthropic)",
    "Marsette Vona"
  ],
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test 'packages/*/test/**/*.test.ts' 'test/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "viewer": "node packages/viewer/bin/viewer.ts",
    "deploy-viewer": "scripts/deploy-viewer.sh"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
